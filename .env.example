# Hallyu backend (auth + Postgres). The publishable key is public-safe; RLS guards all data.
# Kept on HALYU_-prefixed names so the video-storage project can own EXPO_PUBLIC_SUPABASE_*.
EXPO_PUBLIC_HALYU_SUPABASE_URL=https://psmxekrmoltwabefgqpd.supabase.co
EXPO_PUBLIC_HALYU_SUPABASE_ANON_KEY=sb_publishable_C6xEGHQxutS_ub-1ebuUDQ_TxVa_-v0

# Video storage (Rork cloud). EXPO_PUBLIC_SUPABASE_URL is injected automatically by the Rork
# backend entry — video bytes go there (public `videos` bucket), never to the Hallyu DB project.
# See docs/backend/10-video-storage.md.

# Catalog (TMDB). Read-only public client credentials — inlined into the bundle at build time.
# The app ships with working defaults in constants/keys.ts; set these only to override them.
# Empty values are ignored (they never blank the built-in key).
EXPO_PUBLIC_TMDB_ACCESS_TOKEN=
EXPO_PUBLIC_TMDB_API_KEY=

# ---------------------------------------------------------------------------------------------
# Firebase (PRIMARY backend). Client config lives in firebase-applet-config.json — its apiKey is
# a public client identifier (safe to ship; Firestore/Storage rules guard all data). No
# google-services.json is needed: the app uses the Firebase JS SDK, not native Firebase modules.
# NEVER put a service-account key or Admin SDK credential in this repo or in EXPO_PUBLIC_*.
#
# Google Sign-In OAuth client IDs (public identifiers — see constants/keys.ts).
# ANDROID client id is REQUIRED for native Google sign-in (Google Cloud Console → Credentials →
# OAuth client ID → Android, package com.hallyu.app + signing SHA-1). Web defaults to the
# project's own web client; leave these empty until real values exist.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ---------------------------------------------------------------------------------------------
# Backend #3 — FUTURE private backend (preparation only). INACTIVE: the app does not use these yet.
# Leave blank until the provider ("Supa Naija") supplies the project + keys. Hallyu keeps running
# on Backend #1 (auth + Postgres) and Backend #2 (video storage) exactly as before.
#
# Only the URL + publishable (anon) key may be exposed to the client bundle. The service-role key
# is SERVER-SIDE ONLY — keep it in a server/CI secret (GitHub Actions), NEVER in this file with a
# value, and NEVER prefix it with EXPO_PUBLIC_ (that would inline it into the APK).
# See docs/backend/BACKEND-3.md.
EXPO_PUBLIC_BACKEND_3_URL=
EXPO_PUBLIC_BACKEND_3_ANON_KEY=
# Server-side only — do NOT set a value here and do NOT commit one:
BACKEND_3_SERVICE_ROLE_KEY=
