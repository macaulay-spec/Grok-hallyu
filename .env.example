# Catalog (TMDB). Read-only public client credentials — inlined into the bundle at build time.
# The app ships with working defaults in constants/keys.ts; set these only to override them.
# Empty values are ignored (they never blank the built-in key).
EXPO_PUBLIC_TMDB_ACCESS_TOKEN=
EXPO_PUBLIC_TMDB_API_KEY=

# Show the "Preview with demo data" door on the welcome screen (demo builds). Off by default.
EXPO_PUBLIC_SHOW_DEMO=1
