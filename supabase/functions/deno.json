{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "npm:@supabase/supabase-js@2": "npm:@supabase/supabase-js@2"
  },
