# Hallyu — environment template (PLACEHOLDERS ONLY).
#
# Every value below is the literal placeholder text, never a real credential.
# Copy this file to `.env.local` at the repository root (git-ignored) when the Supabase project
# exists, then fill it in. The platform that hosts this workspace blocks writes to `.env*` at the
# repository root, so the template lives here and is copied — nothing else differs.
#
# What may ship inside the app bundle (client-safe):
#   EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY, EXPO_PUBLIC_RORK_APP_KEY
# What must never reach a client (privileged, CI/server only):
#   SUPABASE_SERVICE_ROLE_KEY, RORK_TEST_REFRESH_TOKEN
#
# Full table of credentials, consumers and privilege levels: docs/BACKEND-CREDENTIALS.md

# ── Catalog ───────────────────────────────────────────────────────────────────────────────────
# TMDB is reached through the backend only (supabase/functions/catalog-sync), never from the app.
# The client-side values below are kept for the device-local build and are read by lib/catalog.ts.
EXPO_PUBLIC_TMDB_ACCESS_TOKEN=SUPABASE_PLACEHOLDER_TMDB_ACCESS_TOKEN
EXPO_PUBLIC_TMDB_API_KEY=SUPABASE_PLACEHOLDER_TMDB_API_KEY

# ── Edge Function secrets (server-side only; set with `supabase secrets set`, never in the app) ──
# TMDB_ACCESS_TOKEN   read-only TMDB v4 bearer token used by catalog-sync
# TMDB_API_KEY        v3 API key, used only when no v4 token is set
# TMDB_API_BASE       defaults to https://api.themoviedb.org/3
# TMDB_IMAGE_BASE     defaults to https://image.tmdb.org/t/p
# EXPO_PUSH_URL       defaults to https://exp.host/--/api/v2/push/send
# EXPO_ACCESS_TOKEN   optional Expo push access token (higher rate limits)
# CATALOG_PROVIDER_ID defaults to tmdb (the provider row seeded in supabase/seed.sql)

# ── Supabase (supabase/migrations defines the schema this project expects) ─────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co — client-safe.
EXPO_PUBLIC_SUPABASE_URL=SUPABASE_URL_PLACEHOLDER
# Publishable/anon key. Client-safe: every table has row level security enabled.
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_PLACEHOLDER
# Service-role key. PRIVILEGED — CI, Edge Functions and scripts/verify-backend.mjs only.
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY_PLACEHOLDER

# ── Rork Auth (Google / Apple sign-in) ─────────────────────────────────────────────────────────
# Client-safe. The app exchanges the Rork access token for a Supabase session.
EXPO_PUBLIC_RORK_APP_KEY=RORK_APP_KEY_PLACEHOLDER
EXPO_PUBLIC_RORK_AUTH_URL=https://api.rork.com
# Refresh token for one real test member, used by scripts/verify-backend.mjs. Server-side only.
RORK_TEST_REFRESH_TOKEN=RORK_TEST_REFRESH_TOKEN_PLACEHOLDER

# ── Storage ───────────────────────────────────────────────────────────────────────────────────
# Bucket created by supabase/migrations/20260101121700_17_storage.sql. Private bucket; reads go
# through a signed URL or an authenticated request.
EXPO_PUBLIC_MEDIA_BUCKET=media