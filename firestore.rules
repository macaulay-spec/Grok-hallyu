rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection & Private Subcollections
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update, delete: if isOwner(userId);

      match /watchlist/{watchlistId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(watchlistId);
      }

      match /saved/{postId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /follows/{followId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(userId);
      }

      match /collections/{collectionId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn();
      }

      match /blocks/{blockedUserId} {
        allow read, write: if isOwner(userId);
      }

      match /mutes/{muteId} {
        allow read, write: if isOwner(userId);
      }

      match /dramaNotify/{dramaId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId) && (request.resource.data.userId == request.auth.uid || request.resource.data.authorId == request.auth.uid);
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        // Allow like/comment counters increments
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentCount', 'saveCount', 'state', 'mediaUrl', 'mediaType', 'videoDuration', 'videoWidth', 'videoHeight', 'updatedAt'])
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid);

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(commentId) && (request.resource.data.userId == request.auth.uid || request.resource.data.authorId == request.auth.uid);
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid);
      }

      // Likes subcollection
      match /likes/{likeId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(likeId) && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // Top-level Public Collections
    match /collections/{collectionId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Moderation Reports
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, delete: if false; // server / admin only
    }
  }
}
